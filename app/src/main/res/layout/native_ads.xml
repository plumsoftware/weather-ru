<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.yandex.mobile.ads.nativeads.NativeAdView
        android:id="@+id/nativeAdView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/adsPromo"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:enabled="false"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="10sp"
                        tools:text="16+" />

                    <TextView
                        android:id="@+id/storeView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:enabled="true"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="end|center_vertical"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        tools:text="Реклама" />

                    <ImageView
                        android:id="@+id/imageViewFeedback"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        app:cardBackgroundColor="?attr/colorSurfaceVariant"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/adsIcon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAdvertiser"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="true"
                            android:fontFamily="@font/inter_medium"
                            android:maxLines="3"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp"
                            tools:text="App name" />

                        <TextView
                            android:id="@+id/tvHeadline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:enabled="false"
                            android:fontFamily="@font/inter_bold"
                            android:maxLines="3"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            tools:text="Ad headline text" />

                        <ru.plumsoftware.weatherforecastru.presentation.content.presentation.components.AdRatingView
                            android:id="@+id/rating"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:stepSize="0.5" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textViewDomain"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:enabled="false"
                                android:fontFamily="@font/inter_light"
                                android:maxLines="1"
                                android:textColor="?attr/colorOutline"
                                android:textSize="11sp"
                                tools:text="Google Play" />

                            <TextView
                                android:id="@+id/priceView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:enabled="false"
                                android:fontFamily="@font/inter_light"
                                android:maxLines="1"
                                android:textColor="?attr/colorOutline"
                                android:textSize="11sp"
                                tools:text="Бесплатно" />

                            <TextView
                                android:id="@+id/btnVisitSite"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/native_ad_cta_background"
                                android:fontFamily="@font/inter_medium"
                                android:gravity="center"
                                android:minHeight="0dp"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="6dp"
                                android:text="@string/see_more"
                                android:textAllCaps="false"
                                android:textColor="?attr/colorOnPrimary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.yandex.mobile.ads.nativeads.MediaView
                    android:id="@+id/media"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textViewWarning"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </com.yandex.mobile.ads.nativeads.NativeAdView>
</LinearLayout>
